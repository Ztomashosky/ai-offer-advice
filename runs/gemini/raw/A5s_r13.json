    "groundingSupports": [
     {
      "segment": {
       "startIndex": 45,
       "endIndex": 185,
       "text": "Securing a **$200,000 sign-on bonus** and matching your base salary to **$240,000** completely shifts the risk/reward calculus in your favor"
      },
      "groundingChunkIndices": [
       0,
       1
      ]
     },
     {
      "segment": {
       "startIndex": 187,
       "endIndex": 257,
       "text": "You successfully extracted near top-of-market value for a Google L6 PM"
      },
      "groundingChunkIndices": [
       0
      ]
     },
     {
      "segment": {
       "startIndex": 298,
       "endIndex": 454,
       "text": "Google typically vests new-hire RSUs on a front-loaded schedule (usually **33% / 33% / 22% / 12%** or **38% / 32% / 20% / 10%**) rather than a flat 25%/year"
      },
      "groundingChunkIndices": [
       2,
       3
      ]
     },
     {
      "segment": {
       "startIndex": 458,
       "endIndex": 501,
       "text": "Assuming the standard 33/33/22/12 structure"
      },
      "groundingChunkIndices": [
       2
      ]
     },
     {
      "segment": {
       "startIndex": 772,
       "endIndex": 851,
       "text": "| **Equity Vesting** | ~$250,000 | **$356,400** (33%) | $356,400 + Y1 Refreshes"
      },
      "groundingChunkIndices": [
       2
      ]
     },
     {
      "segment": {
       "startIndex": 1383,
       "endIndex": 1467,
       "text": "**No Drop in Years 2\u20133:** Because Google front-loads the first two years of equity"
      },
      "groundingChunkIndices": [
       2
      ]
     },
     {
      "segment": {
       "startIndex": 1383,
       "endIndex": 1629,
       "text": "**No Drop in Years 2\u20133:** Because Google front-loads the first two years of equity, your Year 2 compensation will comfortably remain in the **$650,000\u2013$700,000 range**, providing plenty of runway before any potential equity drop-off in Year 4"
      },
      "groundingChunkIndices": [
       3
      ]
     },
     {
      "segment": {
       "startIndex": 2004,
       "endIndex": 2133,
       "text": "**Vesting Cadence:** Confirm whether the equity vests monthly or quarterly, and verify the exact annual split (e.g., 33/33/22/12)"
      },
      "groundingChunkIndices": [
       2,
       0
      ]
     },
     {
      "segment": {
       "startIndex": 2299,
       "endIndex": 2343,
       "text": "This is a high-upside, well-negotiated offer"
