    "groundingSupports": [
     {
      "segment": {
       "endIndex": 144,
       "text": "This is a **solid opening offer** for a Google L6 Product Manager, but **you should definitely negotiate rather than accept as-is or walk away**"
      },
      "groundingChunkIndices": [
