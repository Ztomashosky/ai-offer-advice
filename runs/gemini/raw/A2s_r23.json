       1
      ]
     },
     {
      "segment": {
       "startIndex": 354,
       "endIndex": 479,
       "text": "Google uses a **front-loaded vesting schedule** for new-hire equity grants (typically **33% / 33% / 22% / 12%** over 4 years)"
      },
      "groundingChunkIndices": [
       2,
       3
      ]
     },
     {
      "segment": {
       "startIndex": 678,
       "endIndex": 784,
       "text": "**Year 3:** $235,000 + $47,000 + $237,600 (22% RSU) = **~$519,600** *(+ whatever stacks from Refresher 1)*"
