      "groundingChunkIndices": [
       2,
       3
      ]
     },
     {
      "segment": {
       "startIndex": 1565,
       "endIndex": 1630,
       "text": "**Years 3 & 4** experience a severe drop-off (the \"Google Cliff\")"
