      "groundingChunkIndices": [
       3
      ]
     },
     {
      "segment": {
       "startIndex": 2535,
       "endIndex": 2720,
       "text": "Leaving Meta means walking away from unvested equity and imminent bonus cycles\u2014making an initial $0 sign-on standard procedure for Google to test if you'll accept without pushing back"
