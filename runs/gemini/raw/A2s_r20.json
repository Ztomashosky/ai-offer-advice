      "segment": {
       "startIndex": 408,
       "endIndex": 490,
       "text": "| **Base Salary** | $240,000 | $235,000 | **-$5,000** (Pay cut on guaranteed cash)"
      },
      "groundingChunkIndices": [
       0
      ]
     },
     {
      "segment": {
       "startIndex": 493,
       "endIndex": 559,
       "text": "| **Target Bonus** | ~$36,000 (15%) | $47,000 (20%) | **+$11,000**"
