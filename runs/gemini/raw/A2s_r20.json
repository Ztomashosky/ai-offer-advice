      "groundingChunkIndices": [
       0,
       2
      ]
     },
     {
      "segment": {
       "startIndex": 654,
       "endIndex": 733,
       "text": "| **Sign-on Bonus** | N/A | $0 | No buffer for transition risk / unvested stock"
